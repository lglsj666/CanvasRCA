#!/usr/bin/env bash
#SBATCH --account=def-jacobsen_cpu
#SBATCH --partition=cpubase_bycore_b1
#SBATCH --cpus-per-task=8
#SBATCH --hint=nomultithread
#SBATCH --mem=64G
#SBATCH --time=00:30:00
#SBATCH --job-name=rq45-kernel-build
#SBATCH --no-requeue
# Dependency-library compilation only: no GPU, weights, case inputs or tests.
set -euo pipefail
module load StdEnv/2023 python/3.11.5 cuda/12.9
export CUDA_VISIBLE_DEVICES='' MAX_JOBS=8 OMP_NUM_THREADS=1
old=/home/lglsj/.cache/flashinfer/0.6.12
new=/project/def-jacobsen/canvasrca_cache/shared/flashinfer/0.6.12
mkdir -p "$(dirname "$new")"
if [[ -d "$old" && ! -L "$old" ]]; then
  [[ ! -e "$new" ]] || { echo 'Refusing ambiguous dependency cache merge'; exit 2; }
  mv "$old" "$new"
  ln -s "$new" "$old"
fi
[[ -L "$old" && "$(readlink -f "$old")" == "$(readlink -f "$new")" ]] || {
  echo "Unexpected compiler cache mapping: $old -> $(readlink -f "$old")" >&2; exit 2;
}
echo "Verified compiler cache: $old -> $(readlink -f "$new")"
build="$old/90a/cached_ops/gdn_prefill_sm90"
[[ -f "$build/build.ninja" ]] || exit 2
# The exact build graph was generated by the installed FlashInfer runtime.
# Reuse its paths and flags so no kernel/precision implementation is changed.
/scratch/lglsj/CanvasRCA/.venv-inference/bin/ninja -j 8 -C "$build" -f build.ninja
sha256sum "$build/build.ninja" "$build"/*.so
echo 'FlashInfer dependency build completed; no model calls and no GPU requested.'
