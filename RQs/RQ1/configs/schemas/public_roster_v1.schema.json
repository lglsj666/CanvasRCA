{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/public_roster_v1.schema.json",
  "title": "RQ1 public opaque roster v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "seed",
    "partition",
    "exposure_ledger_lineage",
    "assignment_hash",
    "cases",
    "n_cases",
    "status_transition",
    "execution_allowed",
    "model_visible",
    "note"
  ],
  "properties": {
    "schema_version": {"const": "RQ1PublicRosterV1"},
    "status": {"const": "frozen"},
    "seed": {"type": "integer"},
    "partition": {"const": "exposed_development_only"},
    "exposure_ledger_lineage": {"$ref": "#/$defs/lineage"},
    "assignment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opaque_incident_id"],
        "properties": {
          "opaque_incident_id": {
            "type": "string",
            "pattern": "^INC-[A-F0-9]{12}$"
          }
        }
      }
    },
    "n_cases": {"type": "integer", "minimum": 1},
    "status_transition": {"$ref": "#/$defs/transition"},
    "execution_allowed": {"const": true},
    "model_visible": {"const": false},
    "note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ledger_file_sha256",
        "exposure_assignment_hash",
        "cutoff_git_commit",
        "scope"
      ],
      "properties": {
        "schema_version": {"const": "CanvasRCAExposureLedgerV2"},
        "ledger_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exposure_assignment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cutoff_git_commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "scope": {"const": "project_history_complete_through_cutoff"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "draft_sha256", "transition_id"],
      "properties": {
        "from": {"const": "draft_unfrozen"},
        "to": {"const": "frozen"},
        "draft_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "transition_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
