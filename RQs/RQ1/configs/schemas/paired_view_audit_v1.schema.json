{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/paired_view_audit_v1.schema.json",
  "title": "PairedViewAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "query_hash",
    "fact_inventory_hash",
    "fact_count",
    "arms",
    "prompt_composition",
    "parity_ok",
    "leakage_ok"
  ],
  "properties": {
    "schema_version": {"const": "PairedViewAuditV1"},
    "query_id": {"type": "string"},
    "query_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fact_inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fact_count": {"type": "integer", "minimum": 1},
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "text", "bounded_hybrid"],
      "properties": {
        "visual": {"$ref": "#/$defs/arm"},
        "text": {"$ref": "#/$defs/arm"},
        "bounded_hybrid": {"$ref": "#/$defs/arm"}
      }
    },
    "prompt_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "a_sha256", "b_sha256", "hybrid_sha256", "exact_part_concatenation"],
      "properties": {
        "order": {"const": "A_PLUS_B"},
        "a_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "b_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "hybrid_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exact_part_concatenation": {"const": true}
      }
    },
    "parity_ok": {"const": true},
    "leakage_ok": {"const": true},
    "failures": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_inventory_hash", "fact_ids", "location_map", "artifact_sha256"],
      "properties": {
        "fact_inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^F[A-F0-9]{12}$"}
        },
        "location_map": {"type": "object"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
