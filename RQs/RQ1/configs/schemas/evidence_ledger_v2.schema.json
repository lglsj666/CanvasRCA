{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/evidence_ledger_v2.schema.json",
  "title": "EvidenceLedgerV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selected_fact_ids",
    "observations",
    "temporal_relations",
    "directed_edges",
    "candidate_support",
    "candidate_opposition",
    "conflicts",
    "missing_evidence"
  ],
  "properties": {
    "schema_version": {"const": "EvidenceLedgerV2"},
    "selected_fact_ids": {"$ref": "#/$defs/factIds"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "fact_ids", "source_representation", "confidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "fact_ids": {"$ref": "#/$defs/nonemptyFactIds"},
          "source_representation": {"enum": ["visual", "text", "exact_sidecar"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "temporal_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after", "relation", "fact_ids"],
        "properties": {
          "before": {"type": "string"},
          "after": {"type": "string"},
          "relation": {"enum": ["before", "after", "simultaneous", "unknown"]},
          "fact_ids": {"$ref": "#/$defs/nonemptyFactIds"}
        }
      }
    },
    "directed_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caller", "callee", "fact_ids"],
        "properties": {
          "caller": {"type": "string"},
          "callee": {"type": "string"},
          "fact_ids": {"$ref": "#/$defs/nonemptyFactIds"}
        }
      }
    },
    "candidate_support": {"$ref": "#/$defs/candidateMap"},
    "candidate_opposition": {"$ref": "#/$defs/candidateMap"},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "fact_ids"],
        "properties": {
          "claim": {"type": "string"},
          "fact_ids": {"$ref": "#/$defs/nonemptyFactIds"}
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "fact_ids"],
        "properties": {
          "description": {"type": "string"},
          "fact_ids": {"$ref": "#/$defs/nonemptyFactIds"}
        }
      }
    }
  },
  "$defs": {
    "factIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^F[A-F0-9]{12}$"}
    },
    "nonemptyFactIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^F[A-F0-9]{12}$"}
    },
    "candidateMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/factIds"
      }
    }
  }
}
