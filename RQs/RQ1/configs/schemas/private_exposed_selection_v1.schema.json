{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/private_exposed_selection_v1.schema.json",
  "title": "RQ1 private exposed-development selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "seed",
    "partition",
    "selection_policy",
    "private_case_ids",
    "selection_hash"
  ],
  "properties": {
    "schema_version": {"const": "RQ1PrivateExposedSelectionV1"},
    "status": {"const": "frozen"},
    "seed": {"type": "integer"},
    "partition": {"const": "exposed_development_only"},
    "selection_policy": {
      "type": "object",
      "required": ["method", "outcome_blind", "power_analysis_reference"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "outcome_blind": {"const": true},
        "power_analysis_reference": {"type": "string", "minLength": 1}
      }
    },
    "private_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "selection_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
