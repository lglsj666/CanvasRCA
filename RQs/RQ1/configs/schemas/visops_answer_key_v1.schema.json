{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/visops_answer_key_v1.schema.json",
  "title": "PrivateAnswerKeyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "query_hash",
    "answer",
    "answer_type",
    "supporting_fact_ids",
    "derivation"
  ],
  "properties": {
    "schema_version": {"const": "PrivateAnswerKeyV1"},
    "query_id": {"type": "string", "pattern": "^Q-[A-F0-9]{16}$"},
    "query_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer": {},
    "answer_type": {
      "enum": ["number", "sorted_string_set", "directed_edge", "ordered_path"]
    },
    "supporting_fact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^F[A-F0-9]{12}$"}
    },
    "derivation": {"type": "string", "minLength": 1}
  }
}
