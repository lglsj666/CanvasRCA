{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/query_spec_v1.schema.json",
  "title": "QuerySpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "opaque_incident_id",
    "operation",
    "family",
    "telemetry_domains",
    "entities",
    "relative_bin_range",
    "aggregation",
    "fact_ids",
    "fact_inventory_hash",
    "query_hash"
  ],
  "properties": {
    "schema_version": {"const": "QuerySpecV1"},
    "query_id": {"type": "string", "pattern": "^Q-[A-F0-9]{16}$"},
    "opaque_incident_id": {"type": "string", "pattern": "^INC-[A-F0-9]{12}$"},
    "operation": {"type": "string", "minLength": 1},
    "family": {
      "enum": [
        "exact_lookup",
        "temporal_scanning",
        "topology_path",
        "cross_modal_alignment",
        "missingness_uncertainty"
      ]
    },
    "telemetry_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["metric", "log", "trace", "trace_edge", "topology", "coverage", "missingness"]}
    },
    "entities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "relative_bin_range": {
      "type": ["array", "null"],
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "aggregation": {"type": "string", "minLength": 1},
    "fact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^F[A-F0-9]{12}$"}
    },
    "fact_inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameters": {"type": "object"},
    "query_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
