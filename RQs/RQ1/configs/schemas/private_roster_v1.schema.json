{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvasrca.local/schemas/private_roster_v1.schema.json",
  "title": "RQ1 evaluator-only private roster v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "seed",
    "partition",
    "exposure_ledger_lineage",
    "assignment_hash",
    "private_assignment_hash",
    "selection_file_sha256",
    "cases",
    "n_cases",
    "status_transition",
    "execution_allowed",
    "private",
    "note"
  ],
  "properties": {
    "schema_version": {"const": "RQ1PrivateRosterV1"},
    "status": {"const": "frozen"},
    "seed": {"type": "integer"},
    "partition": {"const": "exposed_development_only"},
    "exposure_ledger_lineage": {"$ref": "#/$defs/lineage"},
    "assignment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "private_assignment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selection_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "private_case_id",
          "opaque_incident_id",
          "analysis_dataset",
          "analysis_leakage_group_id"
        ],
        "properties": {
          "private_case_id": {"type": "string", "minLength": 1},
          "opaque_incident_id": {
            "type": "string",
            "pattern": "^INC-[A-F0-9]{12}$"
          },
          "analysis_dataset": {"type": "string", "minLength": 1},
          "analysis_leakage_group_id": {
            "type": ["string", "null"],
            "minLength": 1
          }
        }
      }
    },
    "n_cases": {"type": "integer", "minimum": 1},
    "status_transition": {"$ref": "#/$defs/transition"},
    "execution_allowed": {"const": false},
    "private": {"const": true},
    "note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ledger_file_sha256",
        "exposure_assignment_hash",
        "cutoff_git_commit",
        "scope"
      ],
      "properties": {
        "schema_version": {"const": "CanvasRCAExposureLedgerV2"},
        "ledger_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exposure_assignment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cutoff_git_commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "scope": {"const": "project_history_complete_through_cutoff"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "draft_sha256", "transition_id"],
      "properties": {
        "from": {"const": "draft_unfrozen"},
        "to": {"const": "frozen"},
        "draft_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "transition_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
