# Experiment outputs are machine-local artifacts. Keep code/configuration in Git,
# but never synchronize root-level or RQ-specific results between environments.
/results/
/RQs/**/results/
# Runtime attestations, processing inventories, generated contracts, and other
# machine-local artifacts are reproducible outputs rather than source files.
/artifacts/
# Transient SLURM job-id handoff between submit and the bake-off watcher.
.bakeoff_jobid
/dataset
/venvs
/build
/models
/canvasrca_cache/

# Temporary analysis and recovery work is machine-local.
/tmp/

# RQ-local generated payloads and large model/runtime state must never be
# staged, even when a future runner uses a directory outside results/.
/RQs/**/results/**
/RQs/**/artifacts/**
/RQs/**/checkpoints/**
/RQs/**/models/**
/RQs/**/attention/**
/RQs/**/renders/**
/RQs/**/trajectories/**
/RQs/**/conversations/**
/RQs/**/prepared/**
/RQs/**/preparation/
/RQs/**/cache/
/RQs/**/caches/
/RQs/**/logs/

