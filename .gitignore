__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.env
.env.*
!.env.example
!.env.template
# Local credentials (including the historical misspelling).
secert.md
secret.md
secrets.md
credentials.json
*.pem
*.key
.venv/
.venv-base/
.venv-inference/
models/
wheelhouse/
slurm-*.log
# Experiment outputs are machine-local artifacts. Keep code/configuration in Git,
# but never synchronize root-level or RQ-specific results between environments.
/results/
/RQs/**/results/
# Runtime attestations, processing inventories, generated contracts, and other
# machine-local artifacts are reproducible outputs rather than source files.
/artifacts/
# Transient SLURM job-id handoff between submit and the bake-off watcher.
.bakeoff_jobid
/dataset
/venvs
/build
/models
/canvasrca_cache/

# Temporary analysis and recovery work is machine-local.
/tmp/

# RQ-local generated payloads and large model/runtime state must never be
# staged, even when a future runner uses a directory outside results/.
/RQs/**/results/**
/RQs/**/artifacts/**
/RQs/**/checkpoints/**
/RQs/**/models/**
/RQs/**/attention/**
/RQs/**/renders/**
/RQs/**/trajectories/**
/RQs/**/conversations/**
/RQs/**/prepared/**
/RQs/**/preparation/
/RQs/**/cache/
/RQs/**/caches/
/RQs/**/logs/

# Standalone generated workspaces and model downloads/state.
/preparation/
/prepared/
/cache/
/caches/
/renders/
/dashboards/
/checkpoints/
/attention/
/trajectories/
/conversations/
.cache/
hf_cache/
huggingface_cache/
torch_cache/
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.onnx

# Local experiment workspace
/tmp/rq1_matched_rca_local/
/tmp/ledger_handoff_rca_remote_completed_20260815/
/tmp/ledger_handoff_rca_remote_completed_20260815.files

/eda_cache/
/logs/

# Large generated deletion inventory remains local; the small retirement
# manifest, findings, protected-source hashes and report aggregates are kept.
/docs/RQ2_retirement_assets/deleted_file_inventory.json

/info_theory.pdf

# Unified renderer: installed dependencies/build outputs and local font copy.
/src/renderer/web/node_modules/
/src/renderer/web/dist/
/src/renderer/web/assets/
/src/renderer/outputs/
/src/renderer/previews/

# Bulky reproducible case-level report attachments stay local. Keep report
# Markdown, figures, and compact aggregate tables in version control.
/docs/experiment_reports/**/per_record.csv
/docs/experiment_reports/**/source_provenance.csv
/docs/experiment_reports/**/qa_semantic_v2_per_record.csv
/docs/experiment_reports/**/observations.csv
/docs/experiment_reports/**/scored_cases_enriched.csv
/docs/experiment_reports/**/logical_results.csv
/docs/experiment_reports/**/normalized_results.csv
/docs/experiment_reports/**/method_profiles.csv
/docs/experiment_reports/**/paired_case_features.csv
/docs/experiment_reports/**/paired_profiles.csv
/docs/experiment_reports/**/source_manifest.csv
/docs/experiment_reports/**/selected_evidence_features.json
/docs/experiment_reports/**/final_call_records.csv

# Large case-level exports and duplicate publication staging are local audit
# artifacts. Preserve report Markdown, analysis scripts, and small summaries.
/docs/experiment_reports/**/per_case.csv
/docs/experiment_reports/**/paired_case_deltas.csv
/docs/experiment_reports/**/evidence_composition.csv
/docs/experiment_reports/**/selected_method_profiles.csv
/docs/experiment_reports/**/response_audit.csv
/docs/experiment_reports/**/A_core_records.csv
/docs/experiment_reports/**/rq21_strata.csv
/docs/experiment_reports/**/rq21_attention_correlations_exploratory.csv
/docs/experiment_reports/_qwen_only_reanalysis/staged_assets/
/docs/experiment_plans/RQ3_6_gain_harm_assets/paired_deltas.csv

# Vendored benchmark downloads and decompressed log payloads are not code.
# Keep their local copies; removing a tracked file from the index is separate.
/packages/ReAct/data/*.json
/packages/ReAct/data/*.jsonl
/packages/Denum/Logs/**/*.log
/packages/Denum/decompress_output/

# Generated per-call queues are machine-local runtime state, even when an older
# runner writes them under configs/. Keep the actual experiment configurations.
/RQs/**/configs/remaining_logical_inputs_*.json

# Raw analysis exports and intermediate audit indexes are not report deliverables.
# Keep Markdown/PDF reports, PNG/SVG figures, aggregate tables, analysis scripts,
# and the portable meeting report's referenced-file bundle in important_docs/.
/docs/experiment_reports/**/calls.csv
/docs/experiment_reports/**/qa_calls.csv
/docs/experiment_reports/**/qa_tolerant_calls.csv
/docs/experiment_reports/**/qa_questions.csv
/docs/experiment_reports/**/qa_tolerant_questions.csv
/docs/experiment_reports/**/qa_rca_linked.csv
/docs/experiment_reports/**/attention_records.csv
/docs/experiment_reports/**/attention_regions.csv
/docs/experiment_reports/**/input_lineage.csv
/docs/experiment_reports/**/case_audit_index.json
/docs/experiment_reports/**/contrast_vectors.json
/docs/experiment_reports/**/snapshot.json
/docs/experiment_reports/**/snapshot_previous_cutoff.json
/docs/experiment_reports/**/numeric_codec.csv
/docs/experiment_reports/**/*.log

# Bulky generated cleanup inventories stay local; their Markdown explanations
# and the historical report figures preserved by the cleanup remain versioned.
/docs/issues/*Artifact_Deletion_*.json
/docs/issues/*Artifact_Deletion_*_manifest.json.gz
